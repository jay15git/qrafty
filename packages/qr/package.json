{
  "name": "@qrafty/qr",
  "version": "0.1.0",
  "private": true,
  "description": "Customizable QR code, animated QR, and paper shader React components",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "test": "vitest run"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./react": {
      "types": "./src/react/index.ts",
      "import": "./src/react/index.ts"
    },
    "./dot-matrix": {
      "types": "./src/dot-matrix/index.ts",
      "import": "./src/dot-matrix/index.ts"
    },
    "./shaders": {
      "types": "./src/shaders/index.ts",
      "import": "./src/shaders/index.ts"
    }
  },
  "dependencies": {},
  "peerDependencies": {
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19"
  },
  "peerDependenciesMeta": {
    "@paper-design/shaders": {
      "optional": true
    },
    "@paper-design/shaders-react": {
      "optional": true
    }
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "^4.1.4"
  }
}
