{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": ".cursor/hooks/caveman-session-start.sh"
      }
    ],
    "postToolUse": [
      {
        "matcher": "Shell|Read|Grep",
        "command": "node .cursor/hooks/gitnexus/gitnexus-hook.cjs",
        "timeout": 10
      }
    ]
  }
}
