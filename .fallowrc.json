{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "workspaces": {
    "packages": [".", "packages/*"]
  },
  "ignorePatterns": [".agents/**", "**/dist/**"],
  "duplicates": {
    "minOccurrences": 3
  },
  "rules": {
    "unused-dependencies": "warn"
  },
  "ignoreDependencies": ["agentation", "qr"],
  "ignoreExports": [
    {
      "file": "packages/qr/vendor/react-qr-code/src/lib/qrcodegen/index.ts",
      "exports": ["QrCode", "QrSegment", "Ecc", "Mode"]
    }
  ]
}
