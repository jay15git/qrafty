{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "workspaces": {
    "packages": [
      ".",
      "packages/*"
    ]
  },
  "ignorePatterns": [
    ".agents/**",
    "**/dist/**"
  ],
  "duplicates": {
    "minOccurrences": 3
  },
  "rules": {
    "unused-dependencies": "warn"
  },
  "ignoreExports": [
    {
      "file": "packages/qr/vendor/react-qr-code/src/**",
      "exports": ["*"]
    },
    {
      "file": "components/ui/fill-picker/lib/gradient.ts",
      "exports": ["*"]
    },
    {
      "file": "features/qr-code/model/state.ts",
      "exports": ["*"]
    },
    {
      "file": "features/qr-code/styles/qrafty-gradient-geometry.ts",
      "exports": ["*"]
    }
  ]
}
